APP_ENV=production
APP_URL=https://spahochheim.com.br
API_URL=https://spahochheim.com.br/api
ADMIN_URL=https://spahochheim.com.br/admin

# ── Banco de Dados ──────────────────────────────────────────
DB_HOST=localhost
DB_NAME=hochheim_spa
DB_USER=hochheim_user
DB_PASS=
DB_CHARSET=utf8mb4

# ── Admin (fallback para .htpasswd) ─────────────────────────
ADMIN_USER=admin
ADMIN_PASS_HASH=

# ── Mercado Pago ────────────────────────────────────────────
MP_ACCESS_TOKEN=APP_USR-
MP_PUBLIC_KEY=APP_USR-
MP_WEBHOOK_SECRET=
MP_NOTIFICATION_URL=https://spahochheim.com.br/api/payments/webhook

# ── E-mail (SMTP cPanel) ────────────────────────────────────
MAIL_HOST=mail.spahochheim.com.br
MAIL_PORT=587
MAIL_USER=contato@spahochheim.com.br
MAIL_PASS=
MAIL_FROM_NAME=Day Spa Hochheim
MAIL_ENCRYPTION=tls

# ── Focus NFe (Blumenau/SC — Simpliss) ─────────────────────
# Token da API (Basic Auth: usuário=token, senha=vazia)
# Painel homologação: https://homologacao.focusnfe.com.br
# Painel produção:    https://app.focusnfe.com.br
FOCUSNFE_TOKEN=
FOCUSNFE_ENVIRONMENT=homologacao

# Dados do Prestador (Day Spa Hochheim)
FOCUSNFE_CNPJ_PRESTADOR=
FOCUSNFE_IM_PRESTADOR=

# Tributação (Simples Nacional)
# codigo_opcao_simples_nacional: 1=Não optante, 2=Optante, 3=MEI
FOCUSNFE_OPCAO_SIMPLES=2
# regime_tributario_simples_nacional: 1=Simples Nacional
FOCUSNFE_REGIME_TRIBUTARIO=1
# regime_especial_tributacao: 0=Nenhum, 5=MEI, 6=ME EPP Simples
FOCUSNFE_REGIME_ESPECIAL=0
# Alíquota ISS Blumenau e total de tributos (Simples Nacional)
FOCUSNFE_ALIQUOTA_ISS=2.7463
FOCUSNFE_TOTAL_TRIBUTOS=17.52

# ── Storage ─────────────────────────────────────────────────
# Deixar em branco — usa dirname(__DIR__)/storage via __DIR__ automaticamente
STORAGE_PATH=
STORAGE_URL=https://spahochheim.com.br/api/storage

# ── Assets ──────────────────────────────────────────────────
# Caminho absoluto para a imagem de fundo do cartão presente PDF.
# No cPanel: arquivo fica na raiz do public_html (Vite copia public/* para dist/).
# Deixar em branco = detecção automática.
GIFTCARD_BG_PATH=
