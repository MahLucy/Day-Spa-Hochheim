APP_ENV=production
APP_URL=https://hochheim.com.br
API_URL=https://hochheim.com.br/api
ADMIN_URL=https://hochheim.com.br/admin

# ── Banco de Dados ──────────────────────────────────────────
DB_HOST=localhost
DB_NAME=hochheim_spa
DB_USER=hochheim_user
DB_PASS=
DB_CHARSET=utf8mb4

# ── Admin (fallback para .htpasswd) ─────────────────────────
ADMIN_USER=admin
ADMIN_PASS_HASH=

# ── Mercado Pago ────────────────────────────────────────────
MP_ACCESS_TOKEN=APP_USR-
MP_PUBLIC_KEY=TEST-
MP_WEBHOOK_SECRET=
MP_NOTIFICATION_URL=https://hochheim.com.br/api/payments/webhook

# ── E-mail (SMTP cPanel) ────────────────────────────────────
MAIL_HOST=mail.hochheim.com.br
MAIL_PORT=587
MAIL_USER=noreply@hochheim.com.br
MAIL_PASS=
MAIL_FROM_NAME=Day Spa Hochheim
MAIL_ENCRYPTION=tls

# ── NFE.io ──────────────────────────────────────────────────
NFEIO_API_KEY=
NFEIO_COMPANY_ID=
NFEIO_ENVIRONMENT=homologacao

# ── Storage ─────────────────────────────────────────────────
STORAGE_PATH=/home/hochheim/public_html/storage
STORAGE_URL=https://hochheim.com.br/storage
