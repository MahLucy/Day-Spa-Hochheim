{
    "name": "hochheim/spa-api",
    "description": "Day Spa Hochheim — REST API para e-commerce de cartões presente",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "vlucas/phpdotenv": "^5.6",
        "mercadopago/dx-php": "^3",
        "dompdf/dompdf": "^2.0",
        "endroid/qr-code": "^5.0",
        "phpmailer/phpmailer": "^6.9"
    },
    "autoload": {
        "psr-4": {
            "App\\Controllers\\": "controllers/",
            "App\\Services\\": "services/",
            "App\\Models\\": "models/",
            "App\\Middleware\\": "middleware/",
            "App\\Helpers\\": "helpers/"
        },
        "files": [
            "helpers/Logger.php"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform": {
            "php": "8.2"
        }
    },
    "scripts": {
        "post-install-cmd": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ]
    }
}