VITE_API_URL=/api

# Mercado Pago — chave pública (segura de expor no frontend)
VITE_MP_PUBLIC_KEY=APP_USR-b66698b1-a08d-4fef-b269-dcc783fd3254

# Ambiente
VITE_APP_ENV=development
