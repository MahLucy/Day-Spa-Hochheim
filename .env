# URL base da API — usa proxy do Vite (evita CORS em dev)
# /api/* → http://localhost:8000/* (rewrite configurado em vite.config.js)
VITE_API_URL=/api

# Mercado Pago — chave pública (segura de expor no frontend)
VITE_MP_PUBLIC_KEY=TEST-00000000-0000-0000-0000-000000000000

# Ambiente
VITE_APP_ENV=development
